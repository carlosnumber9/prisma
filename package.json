{
  "name": "prisma",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "10.8.2"
  },
  "scripts": {
    "content:generate": "node scripts/generate-content.mjs",
    "content:check": "node scripts/generate-content.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint scripts tests eslint.config.mjs",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run docs:check && npm run content:check",
    "test:coverage": "node scripts/test-coverage.mjs"
  },
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
