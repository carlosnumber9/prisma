{
  "name": "prisma",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "10.8.2"
  },
  "scripts": {
    "content:generate": "node scripts/generate-content.mjs",
    "content:check": "node scripts/generate-content.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "dev": "next dev",
    "start": "next start",
    "build": "npm run content:check && next build && node scripts/check-portal-build.mjs",
    "test:app": "node --test tests/content.test.mjs tests/presentation.test.mjs tests/reader.test.mjs",
    "typecheck": "npm run typecheck:tools && npm run typecheck:app",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "typecheck:app": "next typegen && tsc --project tsconfig.json",
    "lint": "eslint scripts tests src next.config.ts eslint.config.mjs",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run docs:check && npm run content:check",
    "test:coverage": "node scripts/test-coverage.mjs"
  },
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-config-next": "16.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@vgpu/wgsl": "0.6.0",
    "gsap": "3.15.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vgpu": "0.6.0"
  }
}
